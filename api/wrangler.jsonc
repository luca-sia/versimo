// The versimo.dev app API. Same zone as the site Worker (versimo-site), which
// keeps serving everything else. Secrets are set with `wrangler secret put`:
//   CLIENT_SECRET   of the Versimo client on Lucasia ID, kept in 1Password LUCASIA/versimo-production
//   SESSION_SECRET  32 random bytes or more, kept in the same 1Password item
//   GITHUB_CLIENT_SECRET, GITHUB_APP_PRIVATE_KEY, GITHUB_WEBHOOK_SECRET
//                   from the Versimo GitHub app, kept in 1Password LUCASIA/versimo-github-app
// GITHUB_APP_ID and GITHUB_CLIENT_ID go in vars once the app is registered.
{
  "name": "versimo-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "versimo.dev/api/*", "zone_name": "versimo.dev" },
    { "pattern": "versimo.dev/app/callback", "zone_name": "versimo.dev" },
    { "pattern": "versimo.dev/app/github/callback", "zone_name": "versimo.dev" }
  ],
  "vars": {
    "ISSUER": "https://lucasia.ai/api/auth",
    "CLIENT_ID": "BHZunKpXwayhbXJZXtAuNCEoUjBtizQF",
    "APP_ORIGIN": "https://versimo.dev",
    "GITHUB_APP_SLUG": "versimo"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // versimo-db: pg-one.lucasia.ai, database versimo, user versimo_app.
      "id": "5fc4a1d2d6d54e879b7d8db0c4900f76"
    }
  ]
}
