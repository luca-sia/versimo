{
  "name": "versimo",
  "version": "0.2.0",
  "description": "Release model with no staging. Resolve last, current and next versions of a module for each user.",
  "type": "module",
  "license": "MIT",
  "author": "Lucasia Ltd",
  "homepage": "https://versimo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luca-sia/versimo.git"
  },
  "bugs": {
    "url": "https://github.com/luca-sia/versimo/issues"
  },
  "keywords": ["release", "rollout", "feature-flags", "openfeature", "versioning"],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./schema": "./schema/module-record.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "github-app",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "spec:generate": "node --import tsx spec/generate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
