{
  "name": "Versimo",
  "url": "https://versimo.dev",
  "description": "Reads module tags and opens pull requests for drafts and patches. Never pushes to main.",
  "hook_attributes": {
    "url": "https://versimo.dev/api/github/webhook",
    "active": true
  },
  "redirect_url": "https://versimo.dev/app",
  "callback_urls": ["https://versimo.dev/app/github/callback"],
  "request_oauth_on_install": true,
  "public": true,
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write"
  },
  "default_events": ["create", "pull_request"]
}
